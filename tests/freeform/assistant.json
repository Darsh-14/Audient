{
 "name": "assistant",
 "manifest": "full",
 "about": "Everyday-assistant requests against the web app's full tool set (18 tools). Written 2026-10-02 with the expanded domain. Some cases need real language understanding (contacts in 'Call Mom', 'set the AC to 24', general knowledge); the rule parser is expected to miss those and the language model to get them. Session date 2026-10-02 (a Friday).",
 "cases": [
  {
   "id": "S1",
   "turns": [
    "What's the weather in Pune tomorrow?"
   ],
   "expect": {
    "calls": [
     {
      "tool": "get_weather",
      "args": {
       "location": "Pune",
       "date": "2026-10-03"
      }
     }
    ]
   }
  },
  {
   "id": "S2",
   "turns": [
    "Set an alarm for 6 am"
   ],
   "expect": {
    "commit_args": [
     {
      "tool": "set_alarm",
      "args": {
       "time": "06:00"
      }
     }
    ]
   }
  },
  {
   "id": "S3",
   "turns": [
    "Set an alarm for 6 am, no wait, make it 6:30"
   ],
   "expect": {
    "commits": {
     "set_alarm": 1
    },
    "commit_args": [
     {
      "tool": "set_alarm",
      "args": {
       "time": "06:30"
      }
     }
    ]
   }
  },
  {
   "id": "S4",
   "gap": 0.2,
   "turns": [
    "Set an alarm for 7 am",
    "actually 7:30"
   ],
   "expect": {
    "commits": {
     "set_alarm": 1
    },
    "commit_args": [
     {
      "tool": "set_alarm",
      "args": {
       "time": "07:30"
      }
     }
    ]
   }
  },
  {
   "id": "S5",
   "turns": [
    "Set a timer for 10 minutes"
   ],
   "expect": {
    "commit_args": [
     {
      "tool": "set_timer",
      "args": {
       "minutes": 10
      }
     }
    ]
   }
  },
  {
