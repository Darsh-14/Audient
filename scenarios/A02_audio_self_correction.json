{
 "id": "A02_audio_self_correction",
 "modality": "audio",
 "tags": [
  "audio",
  "self_correction",
  "interruption"
 ],
 "env": {
  "latency": {
   "search_flights": 3.0
  }
 },
 "events": [
  {
   "t": 0.5,
   "type": "audio",
   "path": "assets/audio/a02_search_delhi.wav",
   "end_of_turn": true
  },
  {
   "t": 2.0,
   "type": "interruption"
  },
  {
   "t": 2.0,
   "type": "audio",
   "path": "assets/audio/a02_make_it_bangalore.wav",
   "end_of_turn": true
  }
 ],
 "expect": {
  "cancel": [
   {
    "tool": "search_flights",
    "args": {
     "destination": "Delhi"
    },
    "by": 2.0,
    "grace_s": 1.5
   }
  ],
  "no_calls": [
   {
    "tool": "search_flights",
    "args": {
     "destination": "Delhi"
    },
    "after": 2.0
   }
  ],
  "calls": [
   {
    "tool": "search_flights",
    "args": {
     "origin": "Mumbai",
     "destination": "Bangalore",
     "date": "2026-10-02"
    }
   }
  ],
  "snapshot": {
   "intent": "search_flights",
   "slots": {
    "destination": "Bangalore"
   },
   "status": "completed"
  },
  "response_contains": [
   "Bangalore"
  ]
 },
 "session_date": "2026-10-01",
 "manifest": [
  {
   "name": "search_flights",
   "description": "Search available flights between two cities on a date",
   "side_effect": "read_only",
   "parameters": {
    "type": "object",
    "properties": {
     "origin": {
      "type": "string",
      "description": "departure city"
     },
     "destination": {
      "type": "string",
      "description": "arrival city"
     },
     "date": {
      "type": "string",
      "format": "date",
      "description": "travel date YYYY-MM-DD"
     },
     "passengers": {
      "type": "integer",
      "description": "number of passengers"
     }
    },
    "required": [
     "origin",
     "destination",
     "date"
    ]
   }
  },
  {
   "name": "book_flight",
   "description": "Book a flight returned by search_flights",
   "side_effect": "state_modifying",
   "parameters": {
    "type": "object",
    "properties": {
     "flight_id": {
      "type": "string",
      "description": "flight identifier from search results"
     },
     "passengers": {
      "type": "integer",
      "description": "number of passengers"
     }
    },
    "required": [
     "flight_id",
     "passengers"
    ]
   }
  },
  {
   "name": "create_ticket",
   "description": "Create a customer support ticket for a faulty device",
   "side_effect": "state_modifying",
   "parameters": {
    "type": "object",
    "properties": {
     "device": {
      "type": "string",
      "description": "affected device"
     },
     "issue": {
      "type": "string",
      "description": "description of the problem"
     },
     "priority": {
      "type": "string",
      "enum": [
       "low",
       "medium",
       "high"
      ]
     }
    },
    "required": [
     "device",
     "issue"
    ]
   }
  },
  {
   "name": "get_route",
   "description": "Compute a driving route and ETA to a destination",
   "side_effect": "read_only",
   "parameters": {
    "type": "object",
    "properties": {
     "destination": {
      "type": "string",
      "description": "where to drive"
     }
    },
    "required": [
     "destination"
    ]
   }
  },
  {
   "name": "lookup_manual",
   "description": "Look up the device manual for an error code or indicator light shown on the device",
   "side_effect": "read_only",
   "parameters": {
    "type": "object",
    "properties": {
     "device_model": {
      "type": "string",
      "description": "model number printed on the device"
     },
     "error_code": {
      "type": "string",
      "description": "error code shown on the display"
     },
     "indicator": {
      "type": "string",
      "description": "indicator light state, e.g. blue_blinking_2"
     }
    },
    "required": [
     "device_model"
    ]
   }
  }
 ]
}